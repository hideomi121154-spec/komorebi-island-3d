{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "komorebi-world-rooms",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-14",
  "durable_objects": {
    "bindings": [
      {"name":"ROOMS","class_name":"IslandRoom"}
    ]
  },
  "migrations": [
    {"tag":"v1","new_sqlite_classes":["IslandRoom"]}
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://hideomi121154-spec.github.io"
  }
}
